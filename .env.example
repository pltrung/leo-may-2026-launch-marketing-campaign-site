# Toggle interactive diorama hero (true) vs legacy hero (omit or false). No redeploy needed.
NEXT_PUBLIC_NEW_HERO=true

# Supabase — get these from your project at supabase.com
# URL: Project Settings → General → Project ID → https://<Project ID>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Public key (browser-safe). Use EITHER:
#   - API Keys → "Publishable and secret" tab → Publishable key (sb_publishable_...), OR
#   - API Keys → "Legacy anon, service_role" tab → anon public (eyJ...). Never use service_role here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: API Keys → Secret key or Legacy → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to true only in local/dev to skip OTP for test emails (ev*-*@l, dummy2*@test.local)
# NEXT_PUBLIC_DEV_BYPASS_OTP=false

# VietQR bank transfer (membership payments)
# Techcombank BIN (NAPAS247): 970407
VIETQR_BANK_CODE=970407
VIETQR_ACCOUNT=19027030091996

# VNPay (cards) — IPN: GET /api/vnpay-ipn (whitelist in VNPay merchant portal)
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_HOST=https://sandbox.vnpayment.vn

# MoMo Payment Gateway (Vietnam) — register at developers.momo.vn
# Create payment → member scans QR / opens payUrl. IPN: POST /api/momo-ipn (HTTPS, public URL)
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# Test: https://test-payment.momo.vn/v2/gateway/api/create | Prod: https://payment.momo.vn/v2/gateway/api/create
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# SePay — auto-fulfill VietQR bank transfers (see docs/PAYMENT_GATEWAYS.md)
# Webhook URL: /api/webhooks/sepay | Auth: API Key → Authorization: Apikey <this value>
# SEPAY_WEBHOOK_API_KEY=

# ZaloPay — merchants.zalopay.vn / docs.zalopay.vn
# Create order returns qr_code + order_url. Callback: POST /api/zalopay-callback (KEY2 = callback MAC key)
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# Sandbox: https://sb-openapi.zalopay.vn/v2/create | Prod: https://openapi.zalopay.vn/v2/create
# ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

# Optional: Vercel Cron uses this when calling /api/cron/expiry-reminders
# CRON_SECRET=your-random-secret

# Payment gateway webhook: set secret for /api/payment/webhook (Bearer or X-Webhook-Secret header)
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Stripe (Power Your Cloud upgrades). Without these, upgrade buttons show "Payments coming soon".
# Get keys: https://dashboard.stripe.com/apikeys
# Webhook: https://dashboard.stripe.com/webhooks — add endpoint, event checkout.session.completed (see STRIPE_SETUP.md)
# STRIPE_SECRET_KEY=sk_live_...   or sk_test_... for testing
# STRIPE_WEBHOOK_SECRET=whsec_... (from webhook endpoint "Signing secret")

# Admin email campaigns (Analytics → Members → Email campaigns).
# Option A: short-lived access token (expires ~1h). Get from OAuth 2.0 Playground.
# GMAIL_ACCESS_TOKEN=
# Option B (recommended): refresh token so the app gets new access tokens automatically. Set these three:
# GMAIL_CLIENT_ID=     (from Google Cloud OAuth client — Web or Desktop)
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN= (from OAuth 2.0 Playground after "Exchange authorization code for tokens")
